{
  "name": "サンプル物流株式会社 請求書",
  "note": "1発行元・1レイアウト専用。別フォーマットには使えない。新しい発行元には新しい定義ファイルを作る。",
  "header": {
    "invoice_no": "請求書番号:\\s*(\\S+)",
    "issue_date": "発行日:\\s*(\\S+)",
    "customer": "^(.+?)\\s*御中"
  },
  "line_item": "^(?P<name>.+?)\\s+(?P<qty>[\\d,]+)\\s+(?P<unit>[\\d,]+)\\s+(?P<amount>[\\d,]+)$",
  "line_item_exclude": [
    "品名",
    "小計",
    "消費税",
    "合計"
  ],
  "totals": {
    "subtotal": "小計[^\\n]*?¥([\\d,]+)",
    "tax": "消費税[^\\n]*?¥([\\d,]+)",
    "total": "合計金額[^\\n]*?¥([\\d,]+)"
  },
  "line_item_region": {
    "start": "品名",
    "end": "小計"
  }
}
